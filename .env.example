# I-GUIDE agent — environment template
#
# Copy to .env and fill in. NEVER commit .env, an API key, or Earth Engine credentials.
#
# Only the variables worth setting are listed. Many more exist as tuning knobs with sane
# defaults — grep `os.getenv` if you need one. Every comment below is a fact that cost
# somebody time, not a restatement of the variable name.


# ==============================================================================
# REQUIRED
# ==============================================================================

# Gate on /agent/chat*. Passed as `X-API-KEY` or `Authorization: Bearer <key>`.
# EMPTY DISABLES THE GATE — which is what you want locally and never in a deployment.
AGENT_CHAT_API_KEY=change-me-to-a-long-random-string

# Retrieval index.
OPENSEARCH_NODE=http://your-opensearch-host:9200
OPENSEARCH_INDEX=your-index-name
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_MEMORY_INDEX=chat_memory

# Sentence-embedding service used for semantic retrieval.
FLASK_EMBEDDING_URL=http://embedding-server:5000

# Where uploads and generated artifacts live.
AGENT_FILE_STORAGE_ROOT=./agent_chat_files
UPLOAD_FOLDER=./agent_chat_files/uploads


# ==============================================================================
# WHICH MODEL ANSWERS
#
# With nothing set here the agent uses OpenAI gpt-4o-2024-11-20 — the configuration the
# deployment is validated against, and what every client got before per-request selection
# existed. A request may override provider/model per call; these set the DEFAULT.
# ==============================================================================

# THE switch. Unset (or anything else) = OpenAI. Setting ANVILGPT_MODEL or ANTHROPIC_MODEL
# alone changes nothing about the default — it only decides what that provider resolves to
# when a request names the provider without a model.
# AGENT_LLM_PROVIDER=anvilgpt

# -- OpenAI (the default provider) --
OPENAI_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-2024-11-20
OPENAI_MODEL=gpt-4o-2024-11-20

# -- AnvilGPT (Purdue RCAC, Open WebUI) --
# Ids look like `qwen3.6:27b`, NOT the HuggingFace `Qwen/Qwen3.6-27B` form a vLLM server
# uses; a wrong id 404s. Chat lives at /api/chat/completions, which the client reduces to
# the /api base on its own.
ANVILGPT_URL=https://anvilgpt.rcac.purdue.edu/api/chat/completions
ANVILGPT_KEY=your-anvilgpt-key
ANVILGPT_MODEL=gpt-oss:120b

# -- Anthropic --
# EITHER credential works and they bill different accounts. ANTHROPIC_API_KEY is metered
# API billing. CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) is a Claude SUBSCRIPTION
# credential — it authenticates fine, but third-party apps draw from *extra usage* rather
# than plan limits, so an agent turn 400s until extra usage is added. The token wins when
# both are set.
# ANTHROPIC_API_KEY=your-anthropic-key
# CLAUDE_CODE_OAUTH_TOKEN=your-setup-token
# ANTHROPIC_MODEL=claude-sonnet-5

# -- vLLM / any OpenAI-compatible proxy (takes precedence over OPENAI_* when set) --
# VLLM_PROXY=http://your-vllm-endpoint/v1
# VLLM_API_KEY=your-api-key
# VLLM_MODEL=your-model-name


# ==============================================================================
# CODE PEER
#
# The peer that writes code. Default is the built-in LangChain peer, which generates code
# and runs it through the `execute_code` sandbox. Setting this replaces the whole peer with
# an agentic CLI that iterates inside its own container.
#
# A CLI peer has none of the AGENT's tools — no add_map_layer, no QGIS, no rs-embed — but it
# has its own (shell, files, sub-agents, web) and its container KEEPS NETWORK, unlike the
# execute_code sandbox which runs --network none. Geodata it writes still reaches the map:
# the peer wrapper turns written .geojson into map_layer events.
# ==============================================================================

# langchain (default) | claude | opencode
# Each CLI needs its sandbox image built first:
#   docker build -f Dockerfile.claude   -t agent-claude .
#   docker build -f Dockerfile.opencode -t agent-opencode .
# AGENT_CODE_PEER=langchain

# -- Claude Code peer -- reads ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN from above.
# AGENT_CLAUDE_MODEL=sonnet            # alias, not a pinned id, so it cannot rot
# AGENT_CLAUDE_IMAGE=agent-claude:latest
# AGENT_CLAUDE_TIMEOUT=600
# AGENT_CLAUDE_MEMORY=2g
# AGENT_CLAUDE_CPUS=2.0
# AGENT_CLAUDE_NETWORK=your-compose-network
# The sandbox must not run as root — Claude Code refuses --dangerously-skip-permissions
# under it. Defaults to 1000:1000 when the agent process is root, as it is under compose.
# AGENT_CLAUDE_USER=1000:1000
# The CLI's own tools are UNRESTRICTED by default, on purpose — a peer that can install a
# package, read the traceback and retry is the point of running one, and the container
# carries the safety. Name tools here to narrow it; that also drops WebFetch/WebSearch,
# which reach the open web outside this agent's own per-turn caps.
# AGENT_CLAUDE_ALLOWED_TOOLS=Bash Read Write Edit

# -- opencode peer -- defaults reuse the VLLM_*/OPENAI_* chain above.
# AGENT_OPENCODE_MODEL=your-model-name
# AGENT_OPENCODE_BASE_URL=http://host.docker.internal:8000/v1
# AGENT_OPENCODE_IMAGE=agent-opencode:latest
# AGENT_OPENCODE_TIMEOUT=600


# ==============================================================================
# SANDBOXED CODE EXECUTION
# ==============================================================================

# On by default. The sandbox runs --network none, so generated code cannot fetch anything
# at runtime; a separate install phase has network for pip.
AGENT_CODE_EXEC=1
AGENT_CODE_EXEC_BACKEND=docker
AGENT_CODE_EXEC_IMAGE=python:3.11-slim
# Under Docker-out-of-Docker this path must be bind-mounted from the host at the SAME
# absolute path, or the host daemon cannot mount each run's directory.
AGENT_CODE_EXEC_WORK_ROOT=/tmp/iguide_codeexec
# AGENT_CODE_EXEC_TIMEOUT=120
# AGENT_CODE_EXEC_MEMORY=2g

# Outputs at or above this many MB are reported with their size in the run's stderr,
# after an invisible 89 MB intermediate was being written every turn.
# AGENT_LARGE_ARTIFACT_MB=25


# ==============================================================================
# OPTIONAL SUBSYSTEMS
# ==============================================================================

# -- Knowledge graph --
# NEO4J_URI=bolt://your-neo4j-host:7687
# NEO4J_CONNECTION_STRING=bolt://your-neo4j-host:7687
# NEO4J_USER=neo4j                    # NEO4J_USERNAME is accepted as an alias
# NEO4J_PASSWORD=your-password
# NEO4J_DB=neo4j

# -- Remote-sensing embeddings (rs-embed service) --
# INSIDE A CONTAINER `localhost` is the container itself, not the host: on the compose
# deployment this is the docker bridge address.
RS_EMBED_URL=http://172.17.0.1:8077
# RS_EMBED_TIMEOUT_S=600
# RS_EMBED_ZONAL_TIMEOUT_S=900

# -- MCP spatial-analysis tools --
MCP_SERVER_URL=http://mcp-server:8000/mcp/
# MCP_CACHE_TTL_SECONDS=60
# MCP_ALLOWED_HOSTS=mcp-server:*,127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=http://mcp-server:*,http://127.0.0.1:*,http://localhost:*

# -- Headless QGIS --
# Compose pins these for the container image, because a developer .env carrying host paths
# (a macOS /Applications/QGIS-LTR.app/... prefix) leaves PROJ unable to resolve any CRS,
# and reprojection then puts geometry silently in the wrong place.
# QGIS_PROCESS_BIN=qgis_process
# QGIS_PYTHON_BIN=python
# QGIS_PREFIX_PATH=/path/to/qgis/prefix
# PROJ_LIB=/path/to/proj
# GDAL_DATA=/path/to/gdal

# -- Geocoding / spatial search --
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# Model used to turn a natural-language query into an OpenGeoData search.
# OPENGEODATA_NL_MODEL=gpt-4o

# -- Vision model (MCP image tools) --
# VISION_API_URL=http://your-vision-endpoint
# VISION_API_KEY=your-vision-key
# VISION_API_MODEL=your-vision-model

# -- Object storage (metadata-extraction-server) --
# MINIO_ENDPOINT_URL=http://your-minio-host:9000
# MINIO_ACCESS_KEY_ID=your-access-key
# MINIO_ACCESS_KEY=your-secret-key

# -- LangSmith tracing (read by the SDK, not by this code) --
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=i-guide-agent


# ==============================================================================
# OPEN-WEB ACCESS
#
# Two-step by design: web_search returns metadata only, web_fetch reads ONE page. Both are
# capped per turn in code rather than by prompt.
# ==============================================================================

# AGENT_WEB_ENABLED=true
# AGENT_WEB_MAX_SEARCHES_PER_TURN=3
# AGENT_WEB_MAX_FETCHES_PER_TURN=3
# When the knowledge base returns NOTHING even after the refined retry, search the web
# rather than reporting no results. The only path that reaches the web unelected.
# AGENT_WEB_FALLBACK=true
# Ports a page may be fetched from. This is the main defence for THIS deployment: its own
# services (OpenSearch :9200, embedding :5000, MCP :8000) sit on PUBLIC addresses, so a
# private-range check alone cannot protect them. Widen only if you understand that.
# AGENT_WEB_ALLOWED_PORTS=80,443


# ==============================================================================
# AGENT BEHAVIOUR
# ==============================================================================

# Supervisor-over-peers orchestration. On by default.
AGENT_SUPERVISOR=1
# Streams detail-tier trace events (tool I/O, LLM calls) to the client.
AGENT_DEV=0
# LangGraph recursion limit for nested agent/tool loops.
AGENT_RECURSION_LIMIT=60
# Filesystem-backed SKILL.md bundles.
AGENT_SKILLS_ENABLED=1
# AGENT_SKILL_PATHS=./skills,./.agents/skills

SPATIAL_BACKEND_ENABLED=1
SEMANTIC_BACKEND_ENABLED=1
USE_LLM_ROUTER=1

# Delete uploads and artifacts older than N days. 0/unset keeps them forever.
AGENT_FILE_RETENTION_DAYS=0


# ==============================================================================
# SERVER
# ==============================================================================

# Defaults to 5002; the compose deployment maps host 3500 -> container 5002.
PORT=5002

# Absolute origin for artifact download_urls. LEAVE EMPTY unless you need one: a value
# inherited from a deployment .env makes every local download_url absolute against the
# REMOTE host, and local downloads then 404 with "unknown file_id".
AGENT_PUBLIC_BASE_URL=

# Session memory and the checkpointer are process-local, so multi-turn continuity needs
# ONE worker. Raise this only after enabling persistent memory.
WEB_CONCURRENCY=1

FRONTEND_DOMAIN=http://localhost:3000
LOG_LEVEL=INFO
