# ============================================================
# OpenSearch (required)
# ============================================================
OPENSEARCH_NODE=http://your-opensearch-host:9200
OPENSEARCH_INDEX=your-index-name
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_MEMORY_INDEX=chat_memory

# ============================================================
# Embedding service (required)
# ============================================================
FLASK_EMBEDDING_URL=http://embedding-server:5000

# ============================================================
# LLM configuration (required — pick ONE backend)
# ============================================================
# -- Option A: vLLM / OpenAI-compatible proxy --
VLLM_API_KEY=your-api-key
VLLM_PROXY=http://your-vllm-endpoint/v1
VLLM_MODEL=your-model-name

# -- Option B: OpenAI / OpenAI-compatible --
OPENAI_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# -- Option C: AnvilGPT (legacy direct integration) --
ANVILGPT_URL=https://your-anvilgpt-url/api/chat/completions
ANVILGPT_KEY=your-api-key
ANVILGPT_MODEL=gpt-oss:120b

# ============================================================
# Vision model (optional — used by MCP image tools)
# ============================================================
VISION_API_KEY=your-vision-key
VISION_API_URL=http://your-vision-endpoint
VISION_API_MODEL=your-vision-model

# ============================================================
# Neo4j (optional — enables knowledge graph search)
# ============================================================
NEO4J_CONNECTION_STRING=bolt://your-neo4j-host:7687
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DB=neo4j
SCHEMA_CACHE_TTL_SEC=300

# ============================================================
# Spatial search (optional)
# ============================================================
GOOGLE_MAPS_API_KEY=your-google-maps-key
OPENGEODATA_NL_MODEL=gpt-4o

# ============================================================
# MCP server (optional — enables geospatial analysis tools)
# ============================================================
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_CACHE_TTL_SECONDS=60
# Comma-separated allowed hosts/origins for MCP transport security (Docker overrides these)
# MCP_ALLOWED_HOSTS=mcp-server:*,127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=http://mcp-server:*,http://127.0.0.1:*,http://localhost:*

# ============================================================
# Headless QGIS tools (optional - used by LangChain granular tools)
# ============================================================
# qgis_process executable for QGIS Processing algorithms.
QGIS_PROCESS_BIN=qgis_process
# Python executable that can import qgis.* for standalone PyQGIS tools.
# On many installs this must be the Python bundled/configured with QGIS.
QGIS_PYTHON_BIN=python
# Optional QGIS prefix path for standalone PyQGIS initialization.
# macOS example: /Applications/QGIS.app/Contents/MacOS
# QGIS_PREFIX_PATH=/path/to/qgis/prefix
# Optional PROJ/GDAL data paths when the QGIS bundle does not resolve them automatically.
# PROJ_LIB=/path/to/qgis/Resources/proj
# GDAL_DATA=/path/to/qgis/Resources/gdal
# Optional override for per-session job artifacts. Defaults to AGENT_FILE_STORAGE_ROOT/qgis_jobs.
# QGIS_JOB_ROOT=/absolute/path/to/qgis_jobs

# ============================================================
# Agent chat API key (required for /agent/chat endpoints)
# Set to a strong random secret; pass as X-API-KEY header or
# Authorization: Bearer <key> from the frontend/client.
# ============================================================
AGENT_CHAT_API_KEY=your-agent-chat-api-key

# ============================================================
# Agent file storage
# ============================================================
AGENT_FILE_STORAGE_ROOT=./agent_chat_files
UPLOAD_FOLDER=./agent_chat_files/uploads

# ============================================================
# MinIO (optional — metadata-extraction-server)
# ============================================================
MINIO_ENDPOINT_URL=http://your-minio-host:9000
MINIO_ACCESS_KEY_ID=your-access-key
MINIO_ACCESS_KEY=your-secret-key

# ============================================================
# Feature flags
# ============================================================
SPATIAL_BACKEND_ENABLED=1
SEMANTIC_BACKEND_ENABLED=1
USE_LLM_ROUTING=1

# ============================================================
# Memory / chat history
# ============================================================
MEMORY_EMBEDDER_MODEL=all-MiniLM-L6-v2
MEMORY_CONTEXT_THRESHOLD=0.35

# ============================================================
# ColBERT reranker (optional)
# ============================================================
COLBERT_SKIP_CPP=1

# ============================================================
# LangSmith tracing (optional)
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=i-guide-agent

# ============================================================
# Server / misc
# ============================================================
PORT=5002
FRONTEND_DOMAIN=http://localhost:3000
LOG_LEVEL=INFO
