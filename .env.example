# notebook-validator service
# Copy this file to .env and fill in the values before running docker compose.

# URL of the Node.js backend (internal Docker network in production)
BACKEND_URL=http://backend-server:3501

# Auth header name and value — must match what the backend expects
AUTH_API_KEY=x-auth-key
AUTH_API_KEY_VALUE=

# Flask port for the validator API (default: 5003)
PORT=5003
